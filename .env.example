# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# WiFi Billing & Hotspot Management System
# Copy this file to .env.local for development or .env in production
# ==============================================================================

# Server & Application
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
API_URL=http://localhost:3001
PORTAL_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
APP_SECRET_KEY=change-this-to-a-32-byte-hex-string-for-aes-encryption-at-rest

# Database Persistence (PostgreSQL 16)
DATABASE_URL="postgresql://wifibilling:wifibilling_secure_pass@localhost:5432/wifi_billing_db?schema=public"
POSTGRES_USER=wifibilling
POSTGRES_PASSWORD=wifibilling_secure_pass
POSTGRES_DB=wifi_billing_db
POSTGRES_PORT=5432

# Redis Cache & Background Queue (Redis 7)
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# FreeRADIUS Configuration
RADIUS_HOST=localhost
RADIUS_SECRET=testing123_production_radius_secret
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_COA_PORT=3799

# MikroTik RouterOS Gateway (MikroTik-E7161B)
MIKROTIK_HOST=192.168.88.1
MIKROTIK_API_PORT=8729
MIKROTIK_USE_TLS=true
MIKROTIK_USERNAME=api_billing
MIKROTIK_PASSWORD=secure_router_password
MIKROTIK_HOTSPOT_NAME=hotspot1
MIKROTIK_NAS_IDENTIFIER=MT-E7161B-01

# Safaricom M-Pesa Daraja Gateway
MPESA_ENVIRONMENT=sandbox # 'sandbox' or 'production'
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_SHORTCODE=174379
MPESA_PARTY_B=174379
MPESA_CALLBACK_URL="https://your-public-domain.com/api/webhooks/mpesa"
MPESA_TIMEOUT_SECONDS=90

# Security & Session Tokens
JWT_SECRET=super-secret-jwt-signing-key-minimum-32-characters
COOKIE_SECRET=super-secret-cookie-signing-key-minimum-32-characters
SESSION_TTL_SECONDS=86400

# Logging & Observability
LOG_LEVEL=info # trace, debug, info, warn, error, fatal
